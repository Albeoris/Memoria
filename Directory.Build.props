<Project>
    <PropertyGroup>
        <SolutionDir Condition="'$(SolutionDir)' == ''">$(MSBuildThisFileDirectory)</SolutionDir>
        <LangVersion>latest</LangVersion>
        <EnableDefaultItems>false</EnableDefaultItems>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <Prefer32Bit>false</Prefer32Bit>
        <DeploySpecialEffectPlugin Condition="'$(DeploySpecialEffectPlugin)' == ''">false</DeploySpecialEffectPlugin>
        <IncludeSpecialEffectPlugin Condition="'$(IncludeSpecialEffectPlugin)' == ''">false</IncludeSpecialEffectPlugin>
    </PropertyGroup>
</Project>
